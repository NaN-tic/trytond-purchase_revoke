msgctxt "field:purchase.purchase,ignored_moves:"
msgid "Ignored Moves"
msgstr "ចលនាស្តុកដែលបានមិនអើពើ"

msgctxt "model:ir.action,name:act_purchase_create_pending_moves_wizard"
msgid "Create Pending Moves"
msgstr "បង្កើតចលនាស្តុកដែលរង់ចាំ"

#, python-format
msgctxt "model:ir.message,text:msg_can_not_revoke"
msgid ""
"You cannot revoke \"%(record)s\" because there are moves that are not in Cancel, Draft or Done state:\n"
"\"%(names)s\"."
msgstr ""
"មិនអាចដកហូត «%(record)s» បានទេ ព្រោះមានចលនាស្តុកដែលមិនស្ថិតក្នុងស្ថានភាពបានបោះបង់ សេចក្តីព្រាង ឬបានបញ្ចប់៖\n"
"«%(names)s»។"

msgctxt "model:ir.model.button,confirm:purchase_revoke_button"
msgid "Are you sure you want to revoke purchases?"
msgstr "តើអ្នកពិតជាចង់ដកហូតការទិញឬទេ?"

msgctxt "model:ir.model.button,string:purchase_create_pending_moves_button"
msgid "Create Pending Moves"
msgstr "បង្កើតចលនាស្តុកដែលរង់ចាំ"

msgctxt "model:ir.model.button,string:purchase_revoke_button"
msgid "Revoke"
msgstr "ដកហូត"
